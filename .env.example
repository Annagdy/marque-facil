# Copie para .env (que NÃO vai para o git) e ajuste.
# O compose.yaml já tem valores padrão para uso local; estas variáveis são opcionais lá.

# --- Local (docker compose) ---
POSTGRES_PASSWORD=marque_dev

# --- Aplicação (local e nuvem) ---
# Gere com:  openssl rand -hex 32
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Na nuvem: URL do banco gerenciado
# DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/marquefacil

# 1 = cria dados de exemplo se o banco estiver vazio
# SEED=1

# Fuso da clínica (containers na nuvem rodam em UTC)
# TZ_CLINICA=America/Sao_Paulo

# Só se o frontend ficar em outro endereço que a API
# CORS_ORIGINS=http://localhost:5173
